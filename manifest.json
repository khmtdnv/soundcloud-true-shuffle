{
  "manifest_version": 3,
  "name": "SoundCloud True Shuffle",
  "version": "1.0.0",
  "description": "Автоматически подгружает и честно перемешивает все треки в плейлистах и лайках SoundCloud.",
  "author": "khmtdnv",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
