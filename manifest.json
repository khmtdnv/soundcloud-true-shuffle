{
  "manifest_version": 3,
  "name": "SoundCloud Shuffle Fixer",
  "version": "1.0.0",
  "description": "Fixes SoundCloud shuffle by auto-loading all lazy-loaded tracks in the queue before shuffling.",
  "author": "Antigravity",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
